{
  "name": "dsh-font-studio",
  "version": "1.0.0",
  "type": "module",
  "description": "Font Studio for DeepSeek Harness: text, code and terminal font size and family, plus text colour, weight, italic, letter spacing and line height, with a live preview.",
  "license": "Apache-2.0",
  "author": "GEMLZC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GEMLZC/dsh-font-studio.git"
  },
  "bugs": {
    "url": "https://github.com/GEMLZC/dsh-font-studio/issues"
  },
  "homepage": "https://github.com/GEMLZC/dsh-font-studio#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "font",
    "typography",
    "theme",
    "settings"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
